---
import LayoutBase from '../layouts/Layout.astro';
import Logo from '../assets/logo_arca.png'
import { Image } from 'astro:assets';
---

<LayoutBase title="Bem-vindo à Arca">
  <div class="flex flex-col items-center justify-center h-screen">
    <Image src={Logo} alt="logo" class="max-w-xs"/>
    <h1 class="text-4xl font-bold text-center my-8">Página Inicial</h1>
    <p class="text-lg text-center">Conteúdo da sua página...</p>
  </div>
</LayoutBase>